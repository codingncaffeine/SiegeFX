<Project Sdk="Microsoft.NET.Sdk">

  <!-- Defensive checks that tools/receipts.sh runs: no game content in the
       repository, and the install left untouched. Kept out of the engine
       assemblies on purpose: the
       parity ledger counts their string literals as names the engine reads,
       and the file signatures and extensions here are not game data. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SiegeFX.Guards</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiegeFX.Core\SiegeFX.Core.csproj" />
  </ItemGroup>

</Project>
