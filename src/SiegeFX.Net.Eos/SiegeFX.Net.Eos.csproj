<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SC-MP-EOS P4 — the Epic Online Services provider. Compiles the EOS C#
    SDK source (Epic's, NOT in this repo — licensed, lives outside) together
    with our thin wrapper implementing SiegeFX.Core.Net's ILobbyService /
    ISessionTransport. Excluded from the default solution build; referenced
    only when EOS is wanted. Set EosSdkRoot to wherever the SDK was unzipped;
    default is the download location.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Any processor: one module per operating system serves every machine
         that system ships for (Linux x64 and ARM64, Apple Silicon); EosNative
         loads the native library for the processor it runs on. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Which operating system's EOS bindings the module compiles: Windows64
         (the default, the Windows release), Linux (both Linux tarballs) or Mac
         (the macOS tarball). It follows the artifact, not the machine that
         builds it: publish.sh builds all three. -->
    <EosPlatform Condition="'$(EosPlatform)' == ''">Windows64</EosPlatform>
    <DefineConstants Condition="'$(EosPlatform)' == 'Linux'">EOS_PLATFORM_LINUX;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(EosPlatform)' == 'Mac'">EOS_PLATFORM_OSX;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(EosPlatform)' != 'Linux' and '$(EosPlatform)' != 'Mac'">EOS_PLATFORM_WINDOWS_64;$(DefineConstants)</DefineConstants>
    <!-- Preferred: the SDK unpacked beside the projects (survives Downloads
         cleanups — the v0.4.0 release found the old copy deleted); the
         original Downloads location stays as the fallback. -->
    <EosSdkRoot Condition="'$(EosSdkRoot)' == '' and Exists('I:\Visual Studio Projects\EOS\SDK\Source')">I:\Visual Studio Projects\EOS\SDK</EosSdkRoot>
    <EosSdkRoot Condition="'$(EosSdkRoot)' == ''">$(USERPROFILE)\Downloads\EOS\SDK</EosSdkRoot>
    <!-- Epic's generated SDK trips nullable/obsolete analyzers; silence them
         for the vendor source only (our wrapper stays strict). -->
    <NoWarn>$(NoWarn);CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CS8629;CS8765;CS8767;CS0219;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiegeFX.Core\SiegeFX.Core.csproj" />
  </ItemGroup>

  <!-- Epic's SDK source (external, licensed — never committed). -->
  <ItemGroup>
    <Compile Include="$(EosSdkRoot)\Source\Core\**\*.cs">
      <Link>EosSdk\Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="$(EosSdkRoot)\Source\Generated\**\*.cs">
      <Link>EosSdk\Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- Native runtime alongside the managed assembly. -->
  <ItemGroup>
    <None Include="$(EosSdkRoot)\Bin\EOSSDK-Win64-Shipping.dll" Condition="'$(EosPlatform)' == 'Windows64' and Exists('$(EosSdkRoot)\Bin\EOSSDK-Win64-Shipping.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>EOSSDK-Win64-Shipping.dll</Link>
    </None>
    <None Include="$(EosSdkRoot)\Bin\libEOSSDK-Linux-Shipping.so" Condition="'$(EosPlatform)' == 'Linux' and Exists('$(EosSdkRoot)\Bin\libEOSSDK-Linux-Shipping.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libEOSSDK-Linux-Shipping.so</Link>
    </None>
    <None Include="$(EosSdkRoot)\Bin\libEOSSDK-LinuxArm64-Shipping.so" Condition="'$(EosPlatform)' == 'Linux' and Exists('$(EosSdkRoot)\Bin\libEOSSDK-LinuxArm64-Shipping.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libEOSSDK-LinuxArm64-Shipping.so</Link>
    </None>
    <None Include="$(EosSdkRoot)\Bin\libEOSSDK-Mac-Shipping.dylib" Condition="'$(EosPlatform)' == 'Mac' and Exists('$(EosSdkRoot)\Bin\libEOSSDK-Mac-Shipping.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libEOSSDK-Mac-Shipping.dylib</Link>
    </None>
  </ItemGroup>

</Project>
