<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SiegeFX.Core\SiegeFX.Core.csproj" />
    <!-- Phase 22-SC-MUSIC-FOLD — Audio split. AudioEngine + MusicPlayer +
         WavLoader live in SiegeFX.Audio; OpenAL + NLayer come transitively. -->
    <ProjectReference Include="..\SiegeFX.Audio\SiegeFX.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Phase 24-MAINMENU step 7. Distributable single-file publish.
         Default build keeps the SiegeFX.Runtime.dll/exe naming so
         test-all.bat and the existing dev workflow stay unchanged.
         For a release artifact run:
           dotnet publish src/SiegeFX.Runtime -c Release -r win-x64
                  ==self==contained ==p:PublishSingleFile=true
         (replace the placeholder leading dashes; literal double
         hyphens are illegal inside an MSBuild XML comment).
         The PropertyGroup below activates the bundling knobs so
         Silk.NET's GLFW + OpenAL Soft natives ride inside the
         single .exe and auto-extract on first launch. -->
  </PropertyGroup>

  <PropertyGroup Condition=" '$(PublishSingleFile)' == 'true' ">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
