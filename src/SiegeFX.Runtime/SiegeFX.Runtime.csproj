<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SiegeFX.Core\SiegeFX.Core.csproj" />
    <!-- Phase 22-SC-MUSIC-FOLD — Audio split. AudioEngine + MusicPlayer +
         WavLoader live in SiegeFX.Audio; OpenAL + NLayer come transitively. -->
    <ProjectReference Include="..\SiegeFX.Audio\SiegeFX.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Two builds of one engine. net10.0 runs on Linux (and anywhere else
         .NET and GLFW do). The Windows build adds the in-game video recorder
         (SC-RECORD), whose WinRT projections (Windows.Graphics.Capture +
         Windows.Media.*) only a Windows TFM provides; it is the build the
         Windows release ships. Pick one with -f when running or publishing. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ALPHA PACKAGING — the game ships (and builds) as SiegeFX.exe /
         SiegeFX.dll; "SiegeFX.Runtime" stays the project/folder name only.
         test-all.bat's RUN path and SiegeSmith's RuntimeLauncher probe both
         track the assembly name. Release artifacts come from
         publish-alpha.bat (single-file self-contained; the conditioned
         PropertyGroup below bundles Silk.NET's GLFW + OpenAL Soft natives
         inside the .exe, self-extracting on first launch). -->
    <AssemblyName>SiegeFX</AssemblyName>
    <!-- Release version. Surfaces in the MP diagnostics header (as
         "<Version>+<git-sha>") so two players can confirm they're on the same
         build. Bump alongside each release tag. -->
    <Version>0.4.0</Version>
    <!-- Explorer / exe file icon. The taskbar + title-bar icon is set
         separately at runtime (RenderHost.ApplyWindowIcon) because GLFW does
         not pick up ApplicationIcon for its window. -->
    <ApplicationIcon>Assets\siegefx.ico</ApplicationIcon>
    <!-- One culture on every machine, as in the English original: under a
         German or French locale the save dialog printed "Okt. 6, 2026" and
         "10.6" in an English game. Also leaves ICU out of the Linux
         requirements. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The Windows build: the WGC video recorder, its WASAPI loopback audio
       tap and the shell folder picker. Every other build: no recorder, and
       the desktop portal's folder picker over D-Bus. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Windows-TFM side effects: no PRI packaging (unpackaged app), and
         keep the exe runnable on any Win10 build — WGC gates at runtime. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- SC-RECORD — WASAPI loopback capture feeds the video recorder's
         audio track (records what the user hears; OpenAL has no mix tap). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <Compile Remove="Capture\FolderPicker.Portal.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <Compile Remove="Capture\WgcRecorder.cs;Capture\ProcessLoopbackCapture.cs;Capture\FolderPicker.Windows.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pre-decoded RGBA icon frames (256/48/32/16) handed to
         IWindow.SetWindowIcon at load; see RenderHost.ApplyWindowIcon. -->
    <EmbeddedResource Include="Assets\siegefx_icon.bin">
      <LogicalName>siegefx_icon.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup Condition=" '$(PublishSingleFile)' == 'true' ">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
