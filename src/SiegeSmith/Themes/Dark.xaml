<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════ Palette ══════════
         Dark studio surfaces with a warm forge-bronze accent (the "smith" in
         SiegeSmith). Kept as Color + Brush pairs so gradients/animations can
         reuse the raw colors later. -->
    <Color x:Key="Color.Window">#FF1E1E1E</Color>
    <Color x:Key="Color.Panel">#FF252526</Color>
    <Color x:Key="Color.Surface">#FF2D2D30</Color>
    <Color x:Key="Color.SurfaceHover">#FF3A3D41</Color>
    <Color x:Key="Color.Border">#FF3F3F46</Color>
    <Color x:Key="Color.Foreground">#FFE6E6E6</Color>
    <Color x:Key="Color.Muted">#FF9B9B9B</Color>
    <Color x:Key="Color.Accent">#FFD8A657</Color>
    <Color x:Key="Color.Selection">#FF094771</Color>

    <SolidColorBrush x:Key="Brush.Window"       Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Panel"        Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.Surface"      Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Border"       Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Foreground"   Color="{StaticResource Color.Foreground}"/>
    <SolidColorBrush x:Key="Brush.Muted"        Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Accent"       Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Selection"    Color="{StaticResource Color.Selection}"/>

    <!-- ══════════ Text ══════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Small-caps section label used on panel headers -->
    <Style x:Key="Header.Section" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- ══════════ Menu ══════════ -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
    </Style>

    <!-- ══════════ Status bar ══════════ -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>

    <!-- ══════════ Buttons ══════════ -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ ListBox ══════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ GridSplitter ══════════ -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
    </Style>

    <!-- ══════════ TextBox ══════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- ══════════ Tree ══════════ -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
    </Style>

</ResourceDictionary>
