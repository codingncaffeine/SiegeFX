<Window x:Class="SiegeSmith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiegeSmith.ViewModels"
        xmlns:viewers="clr-namespace:SiegeSmith.ViewModels.Viewers"
        xmlns:controls="clr-namespace:SiegeSmith.Controls"
        Title="SiegeSmith — Dungeon Siege Modding Studio"
        Height="760" Width="1280"
        Background="{StaticResource Brush.Window}"
        Icon="Assets/logo.png"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Tank…" Command="{Binding OpenTankCommand}"/>
                <MenuItem Header="_Close Tank" Command="{Binding CloseTankCommand}"/>
                <Separator/>
                <MenuItem Header="_Refresh Install" Command="{Binding RefreshInstallCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Extract Selected File…" Command="{Binding Explorer.ExtractSelectedCommand}"/>
                <MenuItem Header="Extract _Folder / Tank…" Command="{Binding Explorer.ExtractTreeCommand}"/>
                <Separator/>
                <MenuItem Header="_Build Tank from Folder…" Click="OnBuildTank"/>
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="_Open Project…" Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Project _Files…" Click="OnProjectFiles"/>
                <Separator/>
                <MenuItem Header="_Build &amp; Install to Game" Command="{Binding BuildInstallCommand}"/>
                <MenuItem Header="_Launch Dungeon Siege" Command="{Binding LaunchGameCommand}"/>
            </MenuItem>
            <MenuItem Header="_World">
                <MenuItem Header="Open _World Builder…" Click="OnWorldBuilder"/>
                <MenuItem Header="Open _Effects Lab…" Click="OnEffectsLab"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About SiegeSmith" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding StatusText}"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ░░ Left rail: resource tanks + explorer ░░ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RESOURCE TANKS" Style="{StaticResource Header.Section}"/>
                    <ListBox DockPanel.Dock="Top" MaxHeight="150" ItemsSource="{Binding Tanks}"
                             SelectedItem="{Binding SelectedTank, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button DockPanel.Dock="Top" Content="Open other tank…" Command="{Binding OpenTankCommand}"
                            HorizontalAlignment="Left" Margin="10,8"/>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Border}" Margin="0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="EXPLORER" Style="{StaticResource Header.Section}"/>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Explorer.Categories}" Margin="8,0,8,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Jump}" Margin="2" Padding="8,3" FontSize="12"
                                        ToolTip="Jump to this asset category in the tree"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox DockPanel.Dock="Top" Margin="10,0,10,8" IsEnabled="{Binding HasTank}"
                             Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

                    <Grid>
                        <!-- VFS tree -->
                        <TreeView ItemsSource="{Binding Explorer.Roots}"
                                  SelectedItemChanged="OnTreeSelectedItemChanged"
                                  PreviewMouseRightButtonDown="OnTreePreviewRightDown"
                                  PreviewMouseLeftButtonDown="OnTreePreviewLeftDown"
                                  MouseMove="OnTreeMouseMove"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding Explorer.HasSearch, Converter={StaticResource InverseBoolToVis}}">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Extract file…"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.ExtractSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Extract folder / tank…"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.ExtractTreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Export as PNG…"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.ExportPngCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Open externally"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.OpenExternallyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Copy path"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Copy CRC32"
                                              Command="{Binding PlacementTarget.DataContext.Explorer.CopyCrcCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:TankNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <!-- Search results (flat) -->
                        <ListBox ItemsSource="{Binding Explorer.SearchResults}"
                                 SelectedItem="{Binding Explorer.SelectedNode, Mode=TwoWay}"
                                 Visibility="{Binding Explorer.HasSearch, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty-state hint (declared last so it paints over the empty tree) -->
                        <TextBlock Text="Open a tank to browse its contents." Margin="14,6"
                                   TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}"
                                   Visibility="{Binding HasTank, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Center: welcome / overview / file viewer ░░ -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Window}">
                <Grid>
                    <!-- Welcome (no tank open) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                                Visibility="{Binding HasTank, Converter={StaticResource InverseBoolToVis}}">
                        <Image Source="Assets/banner.png" MaxWidth="520" Stretch="Uniform"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Dungeon Siege Modding Studio" FontSize="15"
                                   Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="{Binding InstallLabel}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Brush.Foreground}"/>
                    </StackPanel>

                    <!-- Overview card (tank open, directory or empty selection) -->
                    <DockPanel Margin="28,24" Visibility="{Binding Explorer.ShowOverview, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Explorer.SelectionTitle}" FontSize="24"
                                       Foreground="{StaticResource Brush.Foreground}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Explorer.SelectionSubtitle}" Foreground="{StaticResource Brush.Muted}"
                                       Margin="0,4,0,18" TextWrapping="Wrap"/>
                            <Button Content="Extract folder / tank…" Command="{Binding Explorer.ExtractTreeCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}"
                                   Text="Select a file to preview it — textures render, gas/scripts show as text, everything else falls back to a hex view."/>
                        <Grid/>
                    </DockPanel>

                    <!-- File viewer (a file is selected) -->
                    <ContentControl Content="{Binding Explorer.CurrentViewer}"
                                    Visibility="{Binding Explorer.HasViewer, Converter={StaticResource BoolToVis}}">
                        <ContentControl.Resources>

                            <!-- Texture -->
                            <DataTemplate DataType="{x:Type viewers:TextureViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"/>
                                            <Button Content="Prev" Command="{Binding PrevSurfaceCommand}" Padding="8,2" Margin="16,0,4,0"
                                                    Visibility="{Binding HasMips, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Next" Command="{Binding NextSurfaceCommand}" Padding="8,2" Margin="0,0,8,0"
                                                    Visibility="{Binding HasMips, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding SurfaceLabel}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"
                                                       Visibility="{Binding HasMips, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Export PNG…" Command="{Binding ExportPngCommand}" Margin="16,0,0,0"/>
                                            <TextBlock Text="{Binding ScaleValue, ElementName=TexZoom, StringFormat={}{0:P0}}"
                                                       Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <TextBlock Text="drag · wheel · dbl-click fits" Foreground="{StaticResource Brush.Muted}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#FF141414" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                        <controls:ZoomPanBorder x:Name="TexZoom">
                                            <Image Source="{Binding Bitmap}" Stretch="None"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </controls:ZoomPanBorder>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Model info (.asp / .sno structure) -->
                            <DataTemplate DataType="{x:Type viewers:ModelInfoViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <Button Content="{Binding TexturedLabel}" Command="{Binding TexturedCommand}" Margin="16,0,0,0"
                                                    ToolTip="Toggle in-game textures vs. flat shading"
                                                    Visibility="{Binding CanTexture, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{Binding WireframeLabel}" Command="{Binding WireframeCommand}" Margin="8,0,0,0"
                                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Reset view" Command="{Binding ResetViewCommand}" Margin="8,0,0,0"
                                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="360" MinWidth="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU-rendered orbit preview: left-drag = orbit, right-drag = pan, wheel = zoom -->
                                        <Border Grid.Column="0" Background="#FF141416" ClipToBounds="True" Cursor="SizeAll"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                                                MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp"
                                                MouseRightButtonDown="OnViewportRightDown" MouseRightButtonUp="OnViewportRightUp"
                                                MouseDown="OnViewportMiddleDown" MouseUp="OnViewportMiddleUp"
                                                MouseMove="OnViewportMouseMove" MouseWheel="OnViewportMouseWheel"
                                                SizeChanged="OnViewportSizeChanged">
                                            <Image Source="{Binding Image}" Stretch="Fill"/>
                                        </Border>

                                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>

                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                            <ItemsControl ItemsSource="{Binding Sections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,14">
                                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Foreground}" Margin="0,0,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5"
                                                                                   Foreground="{StaticResource Brush.Muted}" Margin="8,1,0,1" TextWrapping="Wrap"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Gas (tree / raw / editable, live-validated) -->
                            <DataTemplate DataType="{x:Type viewers:GasViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"/>
                                            <Button Content="Tree" Command="{Binding ShowTreeCommand}" Margin="16,0,0,0" Padding="10,3"/>
                                            <Button Content="Raw"  Command="{Binding ShowRawCommand}"  Margin="6,0,0,0" Padding="10,3"/>
                                            <Button Content="Edit" Command="{Binding EditCommand}"     Margin="6,0,0,0" Padding="10,3"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Edit toolbar: validation status + save (edit mode only) -->
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                               Visibility="{Binding ShowEdit, Converter={StaticResource BoolToVis}}">
                                        <Button DockPanel.Dock="Right" Content="Save as…" Command="{Binding SaveAsCommand}"/>
                                        <Border VerticalAlignment="Center" Padding="8,3" CornerRadius="3" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33D8A657"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditValid}" Value="False">
                                                            <Setter Property="Background" Value="#55C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EditStatus}" Foreground="{StaticResource Brush.Foreground}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DockPanel>

                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                        <Grid>
                                            <TreeView ItemsSource="{Binding Roots}" Background="{StaticResource Brush.Panel}"
                                                      Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}"
                                                      VirtualizingStackPanel.IsVirtualizing="True"
                                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                <TreeView.ItemContainerStyle>
                                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                    </Style>
                                                </TreeView.ItemContainerStyle>
                                                <TreeView.Resources>
                                                    <HierarchicalDataTemplate DataType="{x:Type viewers:GasTreeNode}" ItemsSource="{Binding Children}">
                                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12.5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </HierarchicalDataTemplate>
                                                </TreeView.Resources>
                                            </TreeView>
                                            <!-- #35 — syntax-coloured GAS: headers bronze, attr names blue, values/comments/hex tinted -->
                                            <controls:CodeEditor Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" Syntax="gas"
                                                     Visibility="{Binding ShowRaw, Converter={StaticResource BoolToVis}}"/>

                                            <controls:CodeEditor Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Syntax="gas"
                                                     Visibility="{Binding ShowEdit, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Skrit (script: live-compiled, diagnostics + bytecode disassembly) -->
                            <DataTemplate DataType="{x:Type viewers:SkritViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"/>
                                            <Button Content="Source" Command="{Binding ShowSourceCommand}" Margin="16,0,0,0" Padding="10,3"/>
                                            <Button Content="Disassembly" Command="{Binding ShowDisassemblyCommand}" Margin="6,0,0,0" Padding="10,3"/>
                                            <Button Content="Save as…" Command="{Binding SaveAsCommand}" Margin="6,0,0,0" Padding="10,3"/>
                                            <Border VerticalAlignment="Center" Padding="8,3" CornerRadius="3" Margin="16,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#33D8A657"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                <Setter Property="Background" Value="#55C0392B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Foreground}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="240"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="300" MinWidth="200"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Editable source / read-only disassembly (mode-switched) -->
                                        <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                            <Grid>
                                                <!-- #35 — syntax-coloured Skrit source -->
                                                <controls:CodeEditor Text="{Binding Source, UpdateSourceTrigger=PropertyChanged, Delay=250}" Syntax="skrit"
                                                         Visibility="{Binding ShowSource, Converter={StaticResource BoolToVis}}"/>
                                                <TextBox Text="{Binding Disassembly, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                                                         Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Foreground}"
                                                         BorderThickness="0" Padding="8"
                                                         Visibility="{Binding ShowDisassembly, Converter={StaticResource BoolToVis}}"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                            </Grid>
                                        </Border>

                                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                        <!-- Diagnostics + host-extern catalogue -->
                                        <DockPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock DockPanel.Dock="Top" Text="DIAGNOSTICS" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4"/>
                                            <Border DockPanel.Dock="Top" MaxHeight="170" BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1" Margin="0,0,0,10">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <TextBlock Text="No errors — script compiles cleanly." Margin="8,6" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Brush.Muted}" FontSize="12"
                                                                   Visibility="{Binding Ok, Converter={StaticResource BoolToVis}}"/>
                                                        <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="6">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Foreground="#E08A7A" FontFamily="Consolas"
                                                                               FontSize="12" TextWrapping="Wrap" Margin="0,1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Top" Text="EXTERNS — host symbols referenced" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4"/>
                                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Externs}" Margin="6">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Foreground}"
                                                                           FontFamily="Consolas" FontSize="12" Margin="0,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>

                            <!-- PRS skeletal animation (structural inspector + ED-15 live playback) -->
                            <DataTemplate DataType="{x:Type viewers:PrsAnimationViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding RigInfo}" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- ED-15 — the clip playing on its resolved rig -->
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                                Visibility="{Binding HasRig, Converter={StaticResource BoolToVis}}">
                                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Image Source="{Binding Frame}" Width="460" Height="340" Stretch="Uniform"/>
                                        </Border>
                                        <DockPanel Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Left">
                                            <Button DockPanel.Dock="Left" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Loop the clip on the rig (CPU-skinned with the engine's own animation runtime)"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding ScrubPos, Mode=TwoWay}" VerticalAlignment="Center"
                                                    ToolTip="Scrub through the clip"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Sections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Foreground}" Margin="0,0,0,4"/>
                                                        <ItemsControl ItemsSource="{Binding Lines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5"
                                                                               Foreground="{StaticResource Brush.Muted}" Margin="8,1,0,1" TextWrapping="Wrap"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </DataTemplate>

                            <!-- FLM animated cursor (filmstrip + play/loop) -->
                            <DataTemplate DataType="{x:Type viewers:FlmAnimationViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"/>
                                            <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Padding="12,3" Margin="16,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled" MaxHeight="82" Margin="0,10,0,0">
                                        <ItemsControl ItemsSource="{Binding Frames}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="2" Background="#FF141416">
                                                        <Image Source="{Binding}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Border Background="#FF141416" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                        <Image Source="{Binding CurrentFrame}" Width="256" Height="256"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Audio (.wav via SoundPlayer + waveform; .mp3 via MediaPlayer) -->
                            <DataTemplate DataType="{x:Type viewers:AudioViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="▶ Play" Command="{Binding PlayCommand}" Padding="16,4" Margin="0,0,6,0"/>
                                            <Button Content="■ Stop" Command="{Binding StopCommand}" Padding="16,4" Margin="0,0,16,0"/>
                                            <TextBlock Text="Volume" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding IsMp3, Converter={StaticResource BoolToVis}}"/>
                                            <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                                                    Visibility="{Binding IsMp3, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Border Background="#FF141416" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                VerticalAlignment="Top" Height="220"
                                                Visibility="{Binding IsWav, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding Waveform}" Stretch="Fill" Margin="10"/>
                                        </Border>
                                        <TextBlock Text="♪  MP3 music track — press Play to decode and stream."
                                                   Foreground="{StaticResource Brush.Muted}" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                                                   Visibility="{Binding IsMp3, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Text -->
                            <DataTemplate DataType="{x:Type viewers:TextViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Top" Background="#55C0392B" Padding="8,5" Margin="0,0,0,8" CornerRadius="3"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Foreground}" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                                             Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Foreground}"
                                             BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" Padding="8"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                </DockPanel>
                            </DataTemplate>

                            <!-- Hex -->
                            <DataTemplate DataType="{x:Type viewers:HexViewerViewModel}">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding HexText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                                             Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Foreground}"
                                             BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" Padding="8"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                </DockPanel>
                            </DataTemplate>

                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Right: properties inspector ░░ -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource Header.Section}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Explorer.Properties}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource Brush.Foreground}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
