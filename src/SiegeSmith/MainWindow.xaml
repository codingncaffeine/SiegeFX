<Window x:Class="SiegeSmith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiegeSmith.ViewModels"
        Title="SiegeSmith — Dungeon Siege Modding Studio"
        Height="720" Width="1200"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Tank…" IsEnabled="False"/>
                <MenuItem Header="Open _Install Folder…" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Refresh Install" Command="{Binding RefreshInstallCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help">
                <MenuItem Header="_About SiegeSmith" IsEnabled="False"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Tri-pane workspace: explorer | content | inspector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail: resource tanks (Phase 1 upgrades this to the full VFS tree) -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RESOURCE TANKS"
                               Style="{StaticResource Header.Section}"/>
                    <ListBox ItemsSource="{Binding Tanks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Center: welcome / workspace -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Window}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="SiegeSmith" FontSize="40" FontWeight="Light"
                               Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Dungeon Siege Modding Studio" FontSize="15"
                               Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center"
                               Margin="0,4,0,24"/>
                    <TextBlock Text="{Binding InstallLabel}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource Brush.Foreground}"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Right rail: inspector (populated from Phase 2 onward) -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR"
                               Style="{StaticResource Header.Section}"/>
                    <TextBlock Text="Select an asset to inspect." Margin="10,0"
                               Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
