<Window x:Class="SiegeSmith.WorldBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Builder — SiegeSmith"
        Width="1220" Height="800" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ░░ Node palette ░░ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terrain-node palette -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Text="NODE PALETTE" Style="{StaticResource Header.Section}"/>
                        <TextBox DockPanel.Dock="Top" Margin="10,0,10,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                        <ListBox DockPanel.Dock="Bottom" MaxHeight="120" ItemsSource="{Binding TargetDoors}"
                                 SelectedItem="{Binding SelectedTargetDoor, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Bottom" Text="DOORS ON PALETTE MESH" Style="{StaticResource Header.Section}"/>
                        <ListBox ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedMesh, Mode=TwoWay}"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Object palette (props placed on nodes) -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="OBJECT PALETTE" Style="{StaticResource Header.Section}"/>
                        <Button DockPanel.Dock="Top" Content="{Binding PlacingModeLabel}" Command="{Binding TogglePlacingCommand}"
                                Margin="10,0,10,4" Padding="8,5"
                                ToolTip="Toggle between inert props (non_interactive.gas) and spawnable actors (actor.gas)"/>
                        <TextBlock DockPanel.Dock="Top" Margin="10,0,10,6" Text="{Binding PaletteHint}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Muted}" FontSize="11"/>
                        <TextBox DockPanel.Dock="Top" Margin="10,0,10,6"
                                 Text="{Binding PropSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                        <Button DockPanel.Dock="Top" Content="Place on selected node" Command="{Binding PlaceObjectCommand}"
                                Margin="10,0,10,6" Padding="8,5"
                                ToolTip="Drop the selected object template onto the selected terrain node"/>
                        <Button DockPanel.Dock="Bottom" Content="Delete selected object" Command="{Binding DeleteObjectCommand}"
                                Margin="10,6,10,10" Padding="8,5"/>
                        <ListBox DockPanel.Dock="Bottom" MaxHeight="130" ItemsSource="{Binding PlacedObjects}"
                                 SelectedItem="{Binding SelectedPlacedObject, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Bottom" Text="PLACED OBJECTS" Style="{StaticResource Header.Section}"/>
                        <ListBox ItemsSource="{Binding PropPalette}" SelectedItem="{Binding SelectedProp, Mode=TwoWay}"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Viewport ░░ -->
            <Grid Grid.Column="2">
                <Border x:Name="Viewport" Background="#FF141416" ClipToBounds="True" Cursor="SizeAll"
                        MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp"
                        MouseRightButtonDown="OnViewportRightDown" MouseRightButtonUp="OnViewportRightUp"
                        MouseDown="OnViewportMiddleDown" MouseUp="OnViewportMiddleUp"
                        MouseMove="OnViewportMouseMove" MouseWheel="OnViewportMouseWheel"
                        SizeChanged="OnViewportSizeChanged">
                    <Image Source="{Binding Image}" Stretch="Fill"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                    <Button Content="{Binding TexturedLabel}" Command="{Binding TexturedCommand}" Padding="10,3" Margin="0,0,6,0"
                            ToolTip="Toggle in-game textures vs. flat shading"/>
                    <Button Content="{Binding WireframeLabel}" Command="{Binding WireframeCommand}" Padding="10,3" Margin="0,0,6,0"/>
                    <Button Content="Reset view" Command="{Binding ResetViewCommand}" Padding="10,3" Margin="0,0,6,0"/>
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" Padding="10,3" Margin="0,0,6,0" ToolTip="Undo (Ctrl+Z)"/>
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" Padding="10,3" ToolTip="Redo (Ctrl+Y)"/>
                </StackPanel>

                <TextBlock Text="Pick a node mesh on the left, then Place as anchor to begin your world. Drag to orbit · right-drag to pan · wheel to zoom."
                           Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <Border Background="#DD141416" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading SNO catalogue from the install…" Foreground="{StaticResource Brush.Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Region (placed nodes + build actions) ░░ -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="REGION NODES" Style="{StaticResource Header.Section}"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,10">
                        <Button Content="Place as anchor" Command="{Binding PlaceAnchorCommand}" Margin="0,3" Padding="8,5"/>
                        <Button Content="Connect to selected door" Command="{Binding ConnectCommand}" Margin="0,3" Padding="8,5"/>
                        <Button Content="Link to selected door (close loop)" Command="{Binding LinkExistingCommand}" Margin="0,3" Padding="8,5"
                                ToolTip="Link the selected node's free door to a free door on another placed node — closes a loop without adding a node"/>
                        <Button Content="Delete selected node" Command="{Binding DeleteNodeCommand}" Margin="0,3" Padding="8,5"/>
                        <TextBlock Text="Texture set (selected node)" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="11" Margin="0,10,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableTexsets}" SelectedItem="{Binding SelectedNodeTexset, Mode=TwoWay}"
                                  ToolTip="Re-skin the selected node with another texture set used in this region — the preview updates live"/>
                        <TextBlock Text="Load a region from the game" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="11" Margin="0,12,0,3"/>
                        <ComboBox ItemsSource="{Binding InstallRegions}" SelectedItem="{Binding SelectedInstallRegion, Mode=TwoWay}"
                                  DisplayMemberPath="Display" Margin="0,0,0,3"
                                  ToolTip="Pick a shipped region by name — SiegeSmith already knows where the game is installed"/>
                        <Button Content="…or open a nodes.gas file…" Command="{Binding ImportNodesCommand}" Margin="0,0,0,3" Padding="8,5"
                                ToolTip="Manually browse to any nodes.gas"/>
                        <Button Content="Save nodes.gas…" Command="{Binding SaveNodesCommand}" Margin="0,6,0,3" Padding="8,5"/>

                        <TextBlock Text="Lighting &amp; mood" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="11" Margin="0,12,0,3"/>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Add sun" Command="{Binding AddDirectionalLightCommand}" Margin="0,0,3,0" Padding="8,5"
                                    ToolTip="Add a directional light — reaches the engine renderer and the preview"/>
                            <Button Grid.Column="1" Content="Add point" Command="{Binding AddPointLightCommand}" Margin="3,0,0,0" Padding="8,5"
                                    ToolTip="Add a point light on the selected node (author-only — SiegeFX renders no point-light illumination)"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Lights}" SelectedItem="{Binding SelectedLight, Mode=TwoWay}"
                                 MaxHeight="90" Margin="0,0,0,3">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Visibility="{Binding HasSelectedLight, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ARGB" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedLightColorHex, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"
                                         FontFamily="Consolas" ToolTip="Light colour as 0xAARRGGBB (alpha ignored)"/>
                                <TextBlock Grid.Column="2" Text="Int" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Grid.Column="3" Text="{Binding SelectedLightIntensity, UpdateSourceTrigger=LostFocus}" ToolTip="Intensity"/>
                            </Grid>
                            <Grid Margin="0,0,0,3" Visibility="{Binding SelectedLightIsDirectional, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dir" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedLightDirX, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="Direction X (world)"/>
                                <TextBox Grid.Column="2" Text="{Binding SelectedLightDirY, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="Direction Y (world)"/>
                                <TextBox Grid.Column="3" Text="{Binding SelectedLightDirZ, UpdateSourceTrigger=LostFocus}" ToolTip="Direction Z (world, up)"/>
                            </Grid>
                            <Button Content="Delete selected light" Command="{Binding DeleteLightCommand}" Margin="0,0,0,3" Padding="8,4"/>
                        </StackPanel>
                        <Button Content="{Binding MoodInteriorLabel}" Command="{Binding ToggleMoodInteriorCommand}" Margin="0,3,0,3" Padding="8,4"
                                ToolTip="Interior mood flag (reverb)"/>
                        <TextBox Text="{Binding MoodAmbient, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                 ToolTip="Ambient music track (basename, e.g. m_amb_town) — plays as region audio"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MoodStandard, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0"
                                     ToolTip="Standard music track"/>
                            <TextBox Grid.Column="1" Text="{Binding MoodBattle, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0"
                                     ToolTip="Battle music track"/>
                        </Grid>

                        <TextBlock Text="Custom assets (bundled into the map)" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="11" Margin="0,12,0,3"/>
                        <TextBlock Text="{Binding AssetsLabel}" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Set assets folder…" Command="{Binding SetAssetsFolderCommand}" Margin="0,0,3,0" Padding="8,5"/>
                            <Button Grid.Column="1" Content="Open" Command="{Binding OpenAssetsFolderCommand}" Padding="8,5"/>
                        </Grid>

                        <TextBlock Text="Startable map (SiegeFX engine)" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="11" Margin="0,12,0,3"/>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,3,0" ToolTip="Map name — a map_ prefix is added automatically"/>
                            <TextBox Grid.Column="1" Text="{Binding RegionName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="3,0,0,0" ToolTip="Region name"/>
                        </Grid>
                        <Button Content="Test terrain in engine ▶" Command="{Binding TestInEngineCommand}" Padding="8,5"
                                ToolTip="Pack this region into a .dsmap and launch SiegeFX to walk its terrain"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Validate" Command="{Binding ValidateCommand}" Margin="0,0,3,0" Padding="8,5"
                                    ToolTip="Run the pre-launch checklist"/>
                            <Button Grid.Column="1" Content="Play in engine ▶" Command="{Binding PlayInEngineCommand}" Margin="3,0,0,0" Padding="8,5"
                                    ToolTip="Pack a playable map (start point + seed actor) and launch SiegeFX to walk it as a character"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ValidationRows}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Consolas" FontWeight="Bold" Width="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#FF28C840"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource Brush.Foreground}" Width="250"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ListBox DockPanel.Dock="Bottom" MaxHeight="160" ItemsSource="{Binding SourceDoors}"
                             SelectedItem="{Binding SelectedSourceDoor, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFree}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Text="DOORS ON SELECTED NODE" Style="{StaticResource Header.Section}"/>

                    <ListBox DockPanel.Dock="Bottom" MaxHeight="140" ItemsSource="{Binding OtherFreeDoors}"
                             SelectedItem="{Binding SelectedOtherDoor, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Text="FREE DOORS ON OTHER NODES (LINK TARGET)" Style="{StaticResource Header.Section}"/>

                    <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
