<Window x:Class="SiegeSmith.WorldBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Builder — SiegeSmith"
        Width="1220" Height="800" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ░░ Node palette ░░ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NODE PALETTE" Style="{StaticResource Header.Section}"/>
                    <TextBox DockPanel.Dock="Top" Margin="10,0,10,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                    <ListBox DockPanel.Dock="Bottom" MaxHeight="150" ItemsSource="{Binding TargetDoors}"
                             SelectedItem="{Binding SelectedTargetDoor, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Text="DOORS ON PALETTE MESH" Style="{StaticResource Header.Section}"/>
                    <ListBox ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedMesh, Mode=TwoWay}"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Viewport ░░ -->
            <Grid Grid.Column="2">
                <Border x:Name="Viewport" Background="#FF141416" ClipToBounds="True" Cursor="SizeAll"
                        MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp"
                        MouseMove="OnViewportMouseMove" MouseWheel="OnViewportMouseWheel"
                        SizeChanged="OnViewportSizeChanged">
                    <Image Source="{Binding Image}" Stretch="Fill"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                    <Button Content="{Binding TexturedLabel}" Command="{Binding TexturedCommand}" Padding="10,3" Margin="0,0,6,0"
                            ToolTip="Toggle in-game textures vs. flat shading"/>
                    <Button Content="{Binding WireframeLabel}" Command="{Binding WireframeCommand}" Padding="10,3" Margin="0,0,6,0"/>
                    <Button Content="Reset view" Command="{Binding ResetViewCommand}" Padding="10,3"/>
                </StackPanel>

                <TextBlock Text="Pick a node mesh on the left, then Place as anchor to begin your world. Drag to orbit · wheel to zoom."
                           Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <Border Background="#DD141416" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading SNO catalogue from the install…" Foreground="{StaticResource Brush.Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ░░ Region (placed nodes + build actions) ░░ -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="REGION NODES" Style="{StaticResource Header.Section}"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,10">
                        <Button Content="Place as anchor" Command="{Binding PlaceAnchorCommand}" Margin="0,3" Padding="8,5"/>
                        <Button Content="Connect to selected door" Command="{Binding ConnectCommand}" Margin="0,3" Padding="8,5"/>
                        <Button Content="Delete selected node" Command="{Binding DeleteNodeCommand}" Margin="0,3" Padding="8,5"/>
                        <Button Content="Save nodes.gas…" Command="{Binding SaveNodesCommand}" Margin="0,10,0,3" Padding="8,5"/>
                    </StackPanel>

                    <ListBox DockPanel.Dock="Bottom" MaxHeight="160" ItemsSource="{Binding SourceDoors}"
                             SelectedItem="{Binding SelectedSourceDoor, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFree}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Text="DOORS ON SELECTED NODE" Style="{StaticResource Header.Section}"/>

                    <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
