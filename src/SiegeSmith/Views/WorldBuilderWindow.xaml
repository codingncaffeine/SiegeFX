<Window x:Class="SiegeSmith.WorldBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wb="clr-namespace:SiegeSmith.ViewModels.WorldBuilder"
        Title="World Builder — SiegeSmith"
        Width="1400" Height="880" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedAnyCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}"/>
        <KeyBinding Key="F" Command="{Binding FocusSelectedCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding StoreBookmarkCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding StoreBookmarkCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding StoreBookmarkCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding StoreBookmarkCommand}" CommandParameter="3"/>
        <KeyBinding Key="D1" Command="{Binding RecallBookmarkCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Command="{Binding RecallBookmarkCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Command="{Binding RecallBookmarkCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Command="{Binding RecallBookmarkCommand}" CommandParameter="3"/>
        <KeyBinding Key="F1" Command="{Binding ToggleHotkeysCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="235" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ░░ Toolbar — view + history on the left, build/run on the right ░░ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- ED-13 — search everywhere (Ctrl+F) -->
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchEverywhereBox" Width="170" Padding="4,3"
                                 Text="{Binding SearchEverywhereText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="Search everywhere (Ctrl+F): nodes, objects, effects, logic, dialogue text, quests — pick a result to select it and jump the camera there"/>
                        <TextBlock Text="🔍 search everything…" Foreground="{StaticResource Brush.Muted}" FontSize="11"
                                   Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchEverywhereBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Popup IsOpen="{Binding HasSearchHits, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchEverywhereBox}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" MaxHeight="320" Width="330">
                                <ListBox ItemsSource="{Binding SearchHits}" SelectedItem="{Binding SelectedSearchHit, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Brush.Foreground}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Brush.Muted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Content="Save region…" Command="{Binding SaveNodesCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Write this region's nodes.gas (terrain graph) to disk"/>
                    <Button Content="Validate" Command="{Binding ValidateCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Run the pre-launch checklist — results land on the Map tab below"/>
                    <Button Content="Test terrain ▶" Command="{Binding TestInEngineCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Pack this region into a .dsmap and launch SiegeFX to walk its terrain"/>
                    <Button Content="Play ▶" Command="{Binding PlayInEngineCommand}" Padding="10,4"
                            ToolTip="Pack a playable map (start point + seed actor) and launch SiegeFX to play it"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding TexturedLabel}" Command="{Binding TexturedCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Toggle in-game textures vs. flat shading"/>
                    <Button Content="{Binding WireframeLabel}" Command="{Binding WireframeCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Toggle wireframe"/>
                    <Button Content="{Binding LiveFxLabel}" Command="{Binding LiveFxCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Animate fire/smoke emitters live in the preview (pause on very large regions if it feels heavy)"/>
                    <Button Content="Reset view" Command="{Binding ResetViewCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Frame the whole region at the default angle"/>
                    <Button Content="{Binding OrthoLabel}" Command="{Binding OrthoCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Toggle orthographic / perspective projection (picking follows the same projection)"/>
                    <TextBlock Text="Speed" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Width="62" ItemsSource="{Binding CamSpeeds}" SelectedItem="{Binding CamSpeed, Mode=TwoWay}" Margin="0,0,12,0"
                              ToolTip="WASD fly speed multiplier (hold Shift for 3×, Ctrl for slow)"/>
                    <CheckBox Content="15° rot snap" IsChecked="{Binding SnapAngle, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="Snap Shift-drag rotation to 15° steps — exact right angles and clean diagonals without eyeballing"/>
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" Padding="10,4" Margin="0,0,6,0" ToolTip="Undo (Ctrl+Z)"/>
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" Padding="10,4" ToolTip="Redo (Ctrl+Y)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ░░ Main: Palette | Viewport | Outliner + Inspector ░░ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── Palette (tabbed asset browser) ── -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="Nodes" ToolTip="Terrain siege-node meshes — the building blocks of the region">
                        <DockPanel Margin="0,6,0,0">
                            <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         ToolTip="Filter the node meshes"/>
                                <Button Grid.Column="1" Content="★" Padding="8,2" Command="{Binding ToggleFavoriteMeshCommand}"
                                        ToolTip="Star/unstar the selected mesh — favorites persist between sessions"/>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasFavoriteMeshes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="★ FAVORITES" Style="{StaticResource Header.Section}"/>
                                <ListBox MaxHeight="90" Margin="0,0,0,4" ItemsSource="{Binding FavoriteMeshes}"
                                         SelectedItem="{Binding SelectedFavoriteMesh, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasRecentMeshes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="RECENT" Style="{StaticResource Header.Section}"/>
                                <ListBox MaxHeight="90" Margin="0,0,0,4" ItemsSource="{Binding RecentMeshes}"
                                         SelectedItem="{Binding SelectedRecentMesh, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
                                <Button Content="Place as anchor" Command="{Binding PlaceAnchorCommand}" Margin="0,3" Padding="8,5"
                                        ToolTip="Start the region: the anchor node everything else connects to"/>
                                <Button Content="Connect to selected node" Command="{Binding ConnectCommand}" Margin="0,3" Padding="8,5"
                                        ToolTip="Join the palette door above to the free door picked on the selected node (Inspector, right)"/>
                                <CheckBox Content="🖌 Paint terrain (click/drag in viewport)" IsChecked="{Binding PaintMode, Mode=TwoWay}" Margin="0,5,0,2"
                                          ToolTip="ED-5 — brush mode: each click (or every ~50px of a drag) chains this mesh onto the free door nearest the cursor. No manual door pairing; every step is one undo."/>
                                <Button Content="Replace mesh on selected node" Command="{Binding ReplaceNodeMeshCommand}" Margin="0,3" Padding="8,5"
                                        ToolTip="Swap the selected node's mesh for this one IN PLACE — guid, door connections, and everything anchored to the node survive. Needs matching door ids on the new mesh."/>
                            </StackPanel>
                            <ListBox DockPanel.Dock="Bottom" MaxHeight="110" Margin="0,2,0,0" ItemsSource="{Binding TargetDoors}"
                                     SelectedItem="{Binding SelectedTargetDoor, Mode=TwoWay}"
                                     ToolTip="Which door on the NEW node joins the existing region">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock DockPanel.Dock="Bottom" Text="DOORS ON PALETTE MESH" Style="{StaticResource Header.Section}"/>
                            <!-- ED-7 — thumbnail still of the selected mesh -->
                            <Border DockPanel.Dock="Bottom" Margin="10,4,10,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    Visibility="{Binding HasMeshThumb, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Preview of the selected mesh — drag any list entry into the viewport to place it">
                                <Image Source="{Binding MeshThumb}" Height="132" Stretch="Uniform"/>
                            </Border>
                            <ListBox ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedMesh, Mode=TwoWay}"
                                     PreviewMouseLeftButtonDown="OnPaletteMouseDown" PreviewMouseMove="OnPaletteMouseMove"
                                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ToolTip="Drag a mesh into the viewport: first drop = anchor, later drops paint it onto the nearest free door">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Objects" ToolTip="Props and actors placed on terrain nodes">
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Top" Content="{Binding PlacingModeLabel}" Command="{Binding TogglePlacingCommand}"
                                    Margin="10,0,10,4" Padding="8,5"
                                    ToolTip="Toggle between inert props (non_interactive.gas) and spawnable actors (actor.gas)"/>
                            <TextBlock DockPanel.Dock="Top" Margin="10,0,10,6" Text="{Binding PaletteHint}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11"/>
                            <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0"
                                         Text="{Binding PropSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         ToolTip="Filter the template catalog"/>
                                <ComboBox Grid.Column="1" Width="86" Margin="0,0,4,0" ItemsSource="{Binding PropTags}"
                                          SelectedItem="{Binding SelectedPropTag, Mode=TwoWay}"
                                          ToolTip="ED-7 — tag filter: template-name families (tree, barrel, krug, …) derived from this install's catalog"/>
                                <Button Grid.Column="2" Content="★" Padding="8,2" Command="{Binding ToggleFavoritePropCommand}"
                                        ToolTip="Star/unstar the selected template — favorites persist between sessions"/>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasFavoriteProps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="★ FAVORITES" Style="{StaticResource Header.Section}"/>
                                <ListBox MaxHeight="90" Margin="0,0,0,4" ItemsSource="{Binding FavoriteProps}"
                                         SelectedItem="{Binding SelectedFavoriteProp, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasRecentProps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="RECENT" Style="{StaticResource Header.Section}"/>
                                <ListBox MaxHeight="90" Margin="0,0,0,4" ItemsSource="{Binding RecentProps}"
                                         SelectedItem="{Binding SelectedRecentProp, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
                                <Button Content="Place on selected node" Command="{Binding PlaceObjectCommand}" Padding="8,5"
                                        ToolTip="Drop the selected template onto the selected terrain node — then drag it in the viewport"/>
                                <!-- ED-6 — scatter brush -->
                                <CheckBox Content="🌿 Scatter (click/drag in viewport)" IsChecked="{Binding ScatterMode, Mode=TwoWay}" Margin="0,6,0,3"
                                          ToolTip="Brush mode: each click sprinkles copies of this template around the cursor — grass, trees, rocks, crowds, krug packs. One click = one undo."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="×" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ScatterCounts}" SelectedItem="{Binding ScatterCount, Mode=TwoWay}" Margin="0,0,6,0"
                                              ToolTip="Copies per click"/>
                                    <TextBlock Grid.Column="2" Text="r" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding ScatterRadii}" SelectedItem="{Binding ScatterRadius, Mode=TwoWay}" Margin="0,0,6,0"
                                              ToolTip="Brush radius in world units"/>
                                    <TextBlock Grid.Column="4" Text="gap" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <ComboBox Grid.Column="5" ItemsSource="{Binding ScatterSpacings}" SelectedItem="{Binding ScatterSpacing, Mode=TwoWay}"
                                              ToolTip="Minimum spacing (world units) from existing placements and each other — collision avoidance"/>
                                </Grid>
                                <CheckBox Content="Random facing" IsChecked="{Binding ScatterRandomYaw, Mode=TwoWay}" Margin="0,3,0,0"
                                          ToolTip="Give every scattered copy a random yaw so the patch doesn't look stamped"/>
                            </StackPanel>
                            <!-- ED-7 — thumbnail still of the selected template's model -->
                            <Border DockPanel.Dock="Bottom" Margin="10,4,10,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    Visibility="{Binding HasPropThumb, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Preview of the selected template's model — drag any list entry into the viewport to place it at the drop point">
                                <Image Source="{Binding PropThumb}" Height="132" Stretch="Uniform"/>
                            </Border>
                            <ListBox ItemsSource="{Binding PropPalette}" SelectedItem="{Binding SelectedProp, Mode=TwoWay}"
                                     PreviewMouseLeftButtonDown="OnPaletteMouseDown" PreviewMouseMove="OnPaletteMouseMove"
                                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ToolTip="Drag a template into the viewport to place it exactly where it lands">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Effects" ToolTip="Particle emitters, ground decals, and sound emitters">
                        <StackPanel Margin="10,8">
                            <TextBlock Text="Placed on the selected node; click a marker in the viewport to select it, drag to move."
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,8">
                                <WrapPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="9"/>
                                        <Setter Property="Height" Value="9"/>
                                        <Setter Property="CornerRadius" Value="2"/>
                                        <Setter Property="Margin" Value="0,0,3,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Margin" Value="0,0,9,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </WrapPanel.Resources>
                                <Border Background="#F07A28"/><TextBlock Text="fire"/>
                                <Border Background="#BFBFC8"/><TextBlock Text="smoke"/>
                                <Border Background="#33C2A6"/><TextBlock Text="trigger"/>
                                <Border Background="#4C8DF0"/><TextBlock Text="command"/>
                                <Border Background="#D8A24B"/><TextBlock Text="decal"/>
                                <Border Background="#F2D24C"/><TextBlock Text="light"/>
                                <TextBlock Text="(selected = brighter)"/>
                            </WrapPanel>
                            <Button Content="Add fire emitter" Command="{Binding AddFireEmitterCommand}" Margin="0,0,0,4" Padding="8,5"
                                    ToolTip="Fire particle emitter → emitter.gas (plays in SiegeFX)"/>
                            <Button Content="Add smoke emitter" Command="{Binding AddSmokeEmitterCommand}" Margin="0,0,0,4" Padding="8,5"
                                    ToolTip="Smoke particle emitter → emitter.gas (plays in SiegeFX)"/>
                            <Button Content="Add ground decal" Command="{Binding AddDecalCommand}" Margin="0,0,0,10" Padding="8,5"
                                    ToolTip="Ground decal → decals.gas"/>
                            <TextBlock Text="Sound emitter" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SoundTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0"
                                         ToolTip="Sound-emitter template name → objects/sound.gas (retail DS1 only; silent in the SiegeFX test)"/>
                                <Button Grid.Column="1" Content="Add" Command="{Binding AddSoundCommand}" Padding="10,5"/>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Lights" ToolTip="Directional suns and node-anchored point lights">
                        <StackPanel Margin="10,8">
                            <Button Content="Add sun (directional)" Command="{Binding AddDirectionalLightCommand}" Margin="0,0,0,4" Padding="8,5"
                                    ToolTip="Directional light — reaches the engine renderer and the preview"/>
                            <Button Content="Add point light on selected node" Command="{Binding AddPointLightCommand}" Margin="0,0,0,6" Padding="8,5"
                                    ToolTip="Point light anchored to the selected node — drag its marker in the viewport"/>
                            <TextBlock Text="Lights appear in the Outliner (right); select one to edit its colour, intensity, and direction in the Inspector."
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Logic" ToolTip="Triggers, command/NIS gizmos, conversations">
                        <StackPanel Margin="10,8">
                            <Button Content="Add trigger volume" Command="{Binding AddTriggerCommand}" Margin="0,0,0,4" Padding="8,5"
                                    ToolTip="Trigger → objects/special.gas (condition → action rows, edited in the Inspector)"/>
                            <Button Content="Add command / NIS gizmo" Command="{Binding AddCommandCommand}" Margin="0,0,0,4" Padding="8,5"
                                    ToolTip="cmd_* gizmo → objects/command.gas (AI orders, NIS cinematics)"/>
                            <Button Content="Add conversation" Command="{Binding AddConversationCommand}" Margin="0,0,0,6" Padding="8,5"
                                    ToolTip="Conversation → conversations/conversations.gas; bind it to a placed NPC in the Inspector"/>
                            <TextBlock Text="Each lands on the selected node and shows up in the Outliner; select it there or in the viewport to edit every detail in the Inspector."
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Custom" ToolTip="Import your own meshes and terrain tiles — build entirely new games">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8">
                                <TextBlock Text="Custom assets (bundled into the map)" Style="{StaticResource Header.Section}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AssetsLabel}" Foreground="{StaticResource Brush.Muted}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Set assets folder…" Command="{Binding SetAssetsFolderCommand}" Margin="0,0,3,0" Padding="8,5"/>
                                    <Button Grid.Column="1" Content="Open" Command="{Binding OpenAssetsFolderCommand}" Padding="8,5"/>
                                </Grid>
                                <Button Content="Import mesh (OBJ / glTF) → .asp…" Command="{Binding ImportObjMeshCommand}" Margin="0,3,0,3" Padding="8,5"
                                        ToolTip="Convert a Wavefront OBJ or glTF 2.0 model to a static DS1 .asp (Y-up→Z-up), verify it against the engine reader, and drop it in art/meshes so it bundles into the map"/>
                                <Button Content="Import texture (PNG / JPG…) → .raw…" Command="{Binding ImportTextureCommand}" Margin="0,0,0,3" Padding="8,5"
                                        ToolTip="Convert any image to a DS1 .raw (BGRA, power-of-two ≤512, full mip chain), verified by the engine reader — usable by decals, custom terrain tiles, and templates"/>
                                <Button Content="Import audio (WAV / MP3)…" Command="{Binding ImportAudioCommand}" Margin="0,0,0,10" Padding="8,5"
                                        ToolTip="WAV (engine-verified PCM) → sound/ for sound-emitter cues; MP3 → music/ for mood ambient/standard/battle tracks"/>

                                <!-- ED-16 — prefab shelf (per-user, works across maps) -->
                                <TextBlock Text="Prefabs (reusable groups)" Style="{StaticResource Header.Section}" Margin="0,0,0,4"/>
                                <TextBlock Text="Save any multi-selection as a prefab from the Inspector's Selection page; place it here — everything lands on the selected node with fresh ids, grouped and ready to drag."
                                           Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ListBox MaxHeight="120" ItemsSource="{Binding Prefabs}" SelectedItem="{Binding SelectedPrefab, Mode=TwoWay}" Margin="0,0,0,3"
                                         Visibility="{Binding HasPrefabs, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Place prefab on selected node" Command="{Binding PlacePrefabCommand}" Margin="0,0,4,0" Padding="8,4"
                                            ToolTip="Instantiate every piece of the prefab centred on the selected node — the copies become the selection"/>
                                    <Button Grid.Column="1" Content="🗑" Command="{Binding DeletePrefabCommand}" Padding="8,4"
                                            ToolTip="Delete the selected prefab from your library"/>
                                </Grid>

                                <TextBlock Text="Custom templates (items · monsters · NPCs)" Style="{StaticResource Header.Section}" Margin="0,0,0,4"/>
                                <TextBlock Text="Specialize a shipped template — the base supplies mesh, animation, sounds, and AI; you set the identity and stats. Bundles into the map and loads in-engine."
                                           Foreground="{StaticResource Brush.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding TemplateKinds}" SelectedItem="{Binding TplKind, Mode=TwoWay}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding TplName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                         ToolTip="Template identifier (lowercase, e.g. my_flame_sword)"/>
                                <TextBox Text="{Binding TplBase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                         ToolTip="Base template to specialize — e.g. sword_bastard for a weapon, farmgirl or gremal for an actor. Browse names in the Objects palette."/>
                                <TextBox Text="{Binding TplScreenName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                         ToolTip="In-game display name"/>
                                <Grid Margin="0,0,0,3" Visibility="{Binding TplIsWeapon, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dmg" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TplDamageMin, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Damage minimum"/>
                                    <TextBlock Grid.Column="2" Text="to" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding TplDamageMax, UpdateSourceTrigger=LostFocus}" ToolTip="Damage maximum"/>
                                </Grid>
                                <Grid Margin="0,0,0,3" Visibility="{Binding TplIsArmor, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Defense" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TplDefense, UpdateSourceTrigger=LostFocus}" ToolTip="Armor rating this piece contributes"/>
                                </Grid>
                                <Grid Margin="0,0,0,3" Visibility="{Binding TplIsMonster, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Life" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TplLife, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Hit points"/>
                                    <TextBlock Grid.Column="2" Text="Dmg" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding TplDamageMin, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Melee damage minimum"/>
                                    <TextBlock Grid.Column="4" Text="to" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="5" Text="{Binding TplDamageMax, UpdateSourceTrigger=LostFocus}" ToolTip="Melee damage maximum"/>
                                </Grid>
                                <Button Content="Create template" Command="{Binding CreateTemplateCommand}" Margin="0,0,0,10" Padding="8,5"
                                        ToolTip="Write the template gas into the assets folder (world/contentdb/templates/custom) — monsters/NPCs whose base is placeable appear in the Objects palette immediately"/>

                                <TextBlock Text="Custom terrain tile (.sno)" Style="{StaticResource Header.Section}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TileName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,3,0" ToolTip="Tile name — saved as art/terrain/ss_custom/&lt;name&gt;.sno"/>
                                    <ComboBox Grid.Column="1" Width="80" ItemsSource="{Binding TileKinds}" SelectedItem="{Binding TileKind, Mode=TwoWay}"
                                              ToolTip="Flat floor or a ramp"/>
                                </Grid>
                                <TextBox Text="{Binding TileTexture, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                         ToolTip="Terrain texture set name (resolved as &lt;name&gt;.raw at render — use a shipped texset for an immediate look)"/>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="Size" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                        <TextBox Text="{Binding TileSize, UpdateSourceTrigger=LostFocus}" ToolTip="Tile side length in world units"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,3,0">
                                        <TextBlock Text="Subdiv" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                        <TextBox Text="{Binding TileSubdiv, UpdateSourceTrigger=LostFocus}" ToolTip="Grid subdivisions per side"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding TileIsRamp, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Rise" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                        <TextBox Text="{Binding TileRise, UpdateSourceTrigger=LostFocus}" ToolTip="Height the ramp climbs across the tile"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Walkable (generate nav floor + BSP)" IsChecked="{Binding TileWalkable, Mode=TwoWay}"
                                          Margin="0,0,0,4"
                                          ToolTip="On: slope-classify triangles, flood-fill floor groupings, and build a nav BSP. Off: cosmetic geometry only."/>
                                <Button Content="Generate terrain tile → .sno" Command="{Binding GenerateTerrainTileCommand}" Padding="8,5"
                                        ToolTip="Write a v7.0 .sno (verified against the engine reader) plus a [mesh_file] index entry into the custom assets, so the engine can resolve and load it"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ── Viewport ── -->
            <Grid Grid.Column="2">
                <Border x:Name="Viewport" Background="#FF141416" ClipToBounds="True" Cursor="SizeAll" Focusable="True"
                        MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp"
                        MouseRightButtonDown="OnViewportRightDown" MouseRightButtonUp="OnViewportRightUp"
                        MouseDown="OnViewportMiddleDown" MouseUp="OnViewportMiddleUp"
                        MouseMove="OnViewportMouseMove" MouseWheel="OnViewportMouseWheel"
                        SizeChanged="OnViewportSizeChanged"
                        AllowDrop="True" Drop="OnViewportDrop">
                    <Image Source="{Binding Image}" Stretch="Fill"/>
                </Border>

                <TextBlock Text="Pick a node mesh in the Nodes palette, then Place as anchor to begin your world.&#x0a;&#x0a;Left-drag orbit · right-drag pan · middle-drag spin · wheel zoom · WASD/QE fly (Shift fast)&#x0a;Click to select · Ctrl+click multi-select · drag to move · Shift-drag rotates · F focus&#x0a;Ctrl+D duplicate · Ctrl+C/V copy/paste · Ctrl+1-4 save camera bookmark · 1-4 recall"
                           Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <Border Background="#DD141416" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading SNO catalogue from the install…" Foreground="{StaticResource Brush.Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Border>

                <!-- ED-13 — F1 hotkey cheat sheet -->
                <Border Background="#E6141416" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                        MaxWidth="640" Margin="24" Padding="18,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowHotkeys, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Keyboard &amp; mouse" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Foreground}"/>
                            <TextBlock Text="F1 closes" Foreground="{StaticResource Brush.Muted}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Foreground="{StaticResource Brush.Foreground}" FontSize="12" LineHeight="20" Text="Left-drag — orbit&#x0a;Right-drag — pan&#x0a;Middle-drag — spin&#x0a;Wheel — zoom&#x0a;W A S D / Q E — fly (Shift fast, Ctrl slow)&#x0a;Ctrl+1–4 — save camera bookmark&#x0a;1–4 — recall bookmark&#x0a;F — focus selection"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Foreground}" FontSize="12" LineHeight="20" Text="Click — select · Ctrl+click — multi-select&#x0a;Drag — move · Shift-drag — rotate (15° snap toggle)&#x0a;Ctrl+D — duplicate · Del — delete&#x0a;Ctrl+C / Ctrl+V — copy / paste&#x0a;Ctrl+Z / Ctrl+Y — undo / redo&#x0a;Ctrl+F — search everything&#x0a;Drag palette entry into viewport — place it&#x0a;Brushes: 🖌 paint terrain · 🌿 scatter · 🚶 patrol"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ── Outliner over Inspector ── -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.4*" MinHeight="160"/>
                    </Grid.RowDefinitions>

                    <!-- Scene Outliner -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Text="OUTLINER" Style="{StaticResource Header.Section}"/>
                        <!-- ED-9 — analysis overlays: translucent volumes/radii/bounds in the viewport -->
                        <WrapPanel DockPanel.Dock="Top" Margin="10,0,6,4">
                            <CheckBox Content="Volumes" IsChecked="{Binding OverlayTriggerVolumes, Mode=TwoWay}" Margin="0,0,8,2" FontSize="11"
                                      ToolTip="Show every trigger's activation volume (from its bounding-box condition; 1u default) as a translucent teal box"/>
                            <CheckBox Content="Radii" IsChecked="{Binding OverlayLightRadii, Mode=TwoWay}" Margin="0,0,8,2" FontSize="11"
                                      ToolTip="Show each point light's inner/outer radius as ground discs in the light's colour"/>
                            <CheckBox Content="Nav" IsChecked="{Binding OverlayNavFlags, Mode=TwoWay}" Margin="0,0,8,2" FontSize="11"
                                      ToolTip="Mark nodes that carry a nav flag (logical_flags.gas) with a green cube at the node origin"/>
                            <CheckBox Content="Bounds" IsChecked="{Binding OverlayNodeBounds, Mode=TwoWay}" Margin="0,0,0,2" FontSize="11"
                                      ToolTip="Show every terrain node's bounding box — spot overlaps and gaps at a glance"/>
                        </WrapPanel>
                        <TreeView ItemsSource="{Binding OutlineGroups}" SelectedItemChanged="OnOutlinerSelected"
                                  BorderThickness="0" Background="Transparent">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type wb:OutlineGroup}" ItemsSource="{Binding Items}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Background="{Binding DotBrush}"/>
                                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                        <!-- ED-9 — the family's visibility eye (spatial families only) -->
                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Visibility="{Binding CanHide, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Show/hide this whole family in the viewport — hidden pieces can't be clicked either"/>
                                    </StackPanel>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Inspector — properties of whatever is selected -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Style="{StaticResource Header.Section}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,4,10,10">
                                <TextBlock Text="Select a node, object, or marker — in the viewport or the Outliner — to edit it here."
                                           Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                <!-- ED-1b — multi-selection group tools -->
                                <StackPanel Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Selection" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding MultiText}" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                    <TextBlock Text="Drag any member to move the whole group; Shift-drag orbits it about the centre. Ctrl+D duplicates everything, Del deletes everything — each as one undo step."
                                               Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="Align X" Command="{Binding AlignXCommand}" Margin="0,0,3,3" Padding="6,3"
                                                ToolTip="Move every selected piece to the group's average world-X (straightens a row running north–south)"/>
                                        <Button Content="Align Y" Command="{Binding AlignYCommand}" Margin="3,0,0,3" Padding="6,3"
                                                ToolTip="Move every selected piece to the group's average world-Y (straightens a row running east–west)"/>
                                        <Button Content="Distribute X" Command="{Binding DistributeXCommand}" Margin="0,0,3,0" Padding="6,3"
                                                ToolTip="Space the selection evenly along world X — the two outermost pieces stay put (needs 3+)"/>
                                        <Button Content="Distribute Y" Command="{Binding DistributeYCommand}" Margin="3,0,0,0" Padding="6,3"
                                                ToolTip="Space the selection evenly along world Y — the two outermost pieces stay put (needs 3+)"/>
                                    </UniformGrid>
                                    <!-- ED-13 — batch template swap -->
                                    <Button Content="Set template from palette" Command="{Binding ApplyTemplateToSelectionCommand}" Margin="0,4,0,0" Padding="6,3"
                                            ToolTip="Every placed object in the selection takes the template currently picked in the Objects palette — swap 20 pines for oaks in one undo"/>
                                    <!-- ED-16 — save the selection as a reusable prefab -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding PrefabName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                 ToolTip="Prefab name (e.g. campfire_scene)"/>
                                        <Button Grid.Column="1" Content="💾 Save prefab" Command="{Binding SavePrefabCommand}" Padding="6,3"
                                                ToolTip="Save the whole selection as a reusable group — positions stored relative to its centre. Place it in ANY region from the Custom tab."/>
                                    </Grid>
                                </StackPanel>

                                <!-- Emitter -->
                                <StackPanel Visibility="{Binding HasSelectedEmitter, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Emitter" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes objects/emitter.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <CheckBox Content="Smoke plume (off = fire)" IsChecked="{Binding SelectedEmitterSmoke, Mode=TwoWay}"
                                              Margin="0,2,0,4"
                                              ToolTip="Smoke ships a dark plume; fire ships a red/orange column. Changes the marker colour and emitter.gas dark flag."/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Count" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEmitterCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Particles per burst (1–500)"/>
                                        <TextBlock Grid.Column="2" Text="Size" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedEmitterSize, UpdateSourceTrigger=LostFocus}" ToolTip="Particle size"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fade" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEmitterFade, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Seconds a particle lives before fading"/>
                                        <TextBlock Grid.Column="2" Text="Grow" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedEmitterGrowth, UpdateSourceTrigger=LostFocus}" ToolTip="Growth rate as particles rise"/>
                                    </Grid>
                                    <TextBlock Text="Offset from node (drag the marker in 3D, or type):" Foreground="{StaticResource Brush.Muted}" FontSize="10" Margin="0,2,0,2"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEmitterOffsetX, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="Y" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedEmitterOffsetY, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="4" Text="Z" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="5" Text="{Binding SelectedEmitterOffsetZ, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                    <Button Content="Delete emitter" Command="{Binding DeleteEmitterCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Decal -->
                                <StackPanel Visibility="{Binding HasSelectedDecal, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Decal" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes decals/decals.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedDecalTexture, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Decal texture — .raw basename under Art/Bitmaps/Decals"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="W" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedDecalHoriz, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Horizontal extent (m)"/>
                                        <TextBlock Grid.Column="2" Text="H" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedDecalVert, UpdateSourceTrigger=LostFocus}" ToolTip="Vertical extent (m)"/>
                                    </Grid>
                                    <Button Content="Delete decal" Command="{Binding DeleteDecalCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Light -->
                                <StackPanel Visibility="{Binding HasSelectedLight, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Light" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes lights/lights.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ARGB" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedLightColorHex, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"
                                                 FontFamily="Consolas" ToolTip="Light colour as 0xAARRGGBB (alpha ignored)"/>
                                        <TextBlock Grid.Column="2" Text="Int" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedLightIntensity, UpdateSourceTrigger=LostFocus}" ToolTip="Intensity"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3" Visibility="{Binding SelectedLightIsDirectional, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Dir" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedLightDirX, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="Direction X (world)"/>
                                        <TextBox Grid.Column="2" Text="{Binding SelectedLightDirY, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="Direction Y (world)"/>
                                        <TextBox Grid.Column="3" Text="{Binding SelectedLightDirZ, UpdateSourceTrigger=LostFocus}" ToolTip="Direction Z (world, up)"/>
                                    </Grid>
                                    <Button Content="Delete light" Command="{Binding DeleteLightCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Trigger -->
                                <StackPanel Visibility="{Binding HasSelectedTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Trigger" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes objects/special.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedTrigger.Template, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Trigger template (must resolve, e.g. trigger_generic) — a typo silently never fires"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Add row" Command="{Binding AddTriggerRowCommand}" Margin="0,0,3,0" Padding="6,4"/>
                                        <Button Grid.Column="1" Content="Delete row" Command="{Binding DeleteTriggerRowCommand}" Padding="6,4"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding SelectedTrigger.Rows}" SelectedItem="{Binding SelectedTriggerRow, Mode=TwoWay}"
                                             MaxHeight="54" Margin="0,0,0,3">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{StaticResource Brush.Foreground}" FontSize="11">
                                                    <Run Text="row · "/><Run Text="{Binding Conditions.Count, Mode=OneWay}"/><Run Text=" cond → "/><Run Text="{Binding Actions.Count, Mode=OneWay}"/><Run Text=" act"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Visibility="{Binding HasSelectedTriggerRow, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                        <WrapPanel Margin="0,0,0,3">
                                            <CheckBox Content="single_shot" IsChecked="{Binding SelectedTriggerRow.SingleShot}" Margin="0,0,8,0"/>
                                            <CheckBox Content="start_active" IsChecked="{Binding SelectedTriggerRow.StartActive}" Margin="0,0,8,0"/>
                                            <CheckBox Content="flip_flop" IsChecked="{Binding SelectedTriggerRow.FlipFlop}"
                                                      ToolTip="Parsed but inert in SiegeFX (author-only)"/>
                                        </WrapPanel>
                                        <TextBox Text="{Binding SelectedTriggerRow.OccupantsGroup, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"
                                                 ToolTip="occupants_group (optional)"/>
                                        <TextBlock Text="Conditions (ANDed)" Foreground="{StaticResource Brush.Muted}" FontSize="10" Margin="0,0,0,2"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="+ cond" Command="{Binding AddConditionCommand}" Margin="0,0,3,0" Padding="4,3"/>
                                            <Button Grid.Column="1" Content="− cond" Command="{Binding DeleteConditionCommand}" Padding="4,3"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding SelectedTriggerRow.Conditions}" SelectedItem="{Binding SelectedCondition, Mode=TwoWay}"
                                                 MaxHeight="50" Margin="0,0,0,3">
                                            <ListBox.ItemTemplate><DataTemplate>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontFamily="Consolas" FontSize="10"/>
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Visibility="{Binding HasSelectedCondition, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                            <ComboBox ItemsSource="{Binding ConditionVerbs}" SelectedItem="{Binding CondVerb}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding CondArgs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" ToolTip="Argument list, e.g. &quot;we_entered_world&quot; or 4.0"/>
                                            <WrapPanel>
                                                <CheckBox Content="when_false" IsChecked="{Binding CondWhenFalse}" Margin="0,0,8,0"/>
                                                <TextBlock Text="grp" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding CondGroup, UpdateSourceTrigger=LostFocus}" Width="30" Margin="0,0,8,0"/>
                                                <TextBlock Text="delay" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding CondDelay, UpdateSourceTrigger=LostFocus}" Width="40"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock Text="Actions (sequential)" Foreground="{StaticResource Brush.Muted}" FontSize="10" Margin="0,0,0,2"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="+ act" Command="{Binding AddActionCommand}" Margin="0,0,3,0" Padding="4,3"/>
                                            <Button Grid.Column="1" Content="− act" Command="{Binding DeleteActionCommand}" Padding="4,3"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding SelectedTriggerRow.Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                                 MaxHeight="50" Margin="0,0,0,3">
                                            <ListBox.ItemTemplate><DataTemplate>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontFamily="Consolas" FontSize="10"/>
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Visibility="{Binding HasSelectedAction, Converter={StaticResource BoolToVis}}">
                                            <ComboBox ItemsSource="{Binding ActionVerbs}" SelectedItem="{Binding ActVerb}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding ActArgs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" ToolTip="Argument list, e.g. &quot;my_msg&quot;,0x01000001"/>
                                            <WrapPanel>
                                                <TextBlock Text="grp" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding ActGroup, UpdateSourceTrigger=LostFocus}" Width="30" Margin="0,0,8,0"/>
                                                <TextBlock Text="delay" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding ActDelay, UpdateSourceTrigger=LostFocus}" Width="40"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="Delete trigger" Command="{Binding DeleteTriggerCommand}" Margin="0,4,0,0" Padding="8,4"/>
                                </StackPanel>

                                <!-- Command / NIS -->
                                <StackPanel Visibility="{Binding HasSelectedCommand, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Command / NIS" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes objects/command.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding CommandKinds}" SelectedItem="{Binding CmdKindSel}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CmdNextScid, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" ToolTip="next_scid — chains the next NIS/command step (0x…)"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CmdTarget1, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="target1 (0x…)"/>
                                        <TextBox Grid.Column="1" Text="{Binding CmdTarget2, UpdateSourceTrigger=LostFocus}" ToolTip="target2 (0x…)"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CmdClientScid, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0" ToolTip="client_scid (0x…)"/>
                                        <TextBox Grid.Column="1" Text="{Binding CmdDuration, UpdateSourceTrigger=LostFocus}" ToolTip="duration (s)"/>
                                    </Grid>
                                    <TextBox Text="{Binding CmdOrder, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" ToolTip="order (optional)"/>
                                    <Button Content="Delete command" Command="{Binding DeleteCommandCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Conversation -->
                                <StackPanel Visibility="{Binding HasSelectedConversation, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Conversation" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes conversations/conversations.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedConversationKey, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Conversation key (conversation_ prefix added automatically)"/>
                                    <Button Content="Bind to selected placed actor" Command="{Binding BindConversationCommand}" Margin="0,0,0,3" Padding="8,4"
                                            ToolTip="Wires this conversation into the actor selected in the Outliner's Objects group"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Add line" Command="{Binding AddDialogueCommand}" Margin="0,0,3,0" Padding="6,4"/>
                                        <Button Grid.Column="1" Content="Delete line" Command="{Binding DeleteDialogueCommand}" Padding="6,4"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding SelectedConversation.Nodes}" SelectedItem="{Binding SelectedDialogue, Mode=TwoWay}"
                                             MaxHeight="70" Margin="0,0,0,3">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Visibility="{Binding HasSelectedDialogue, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="order" Foreground="{StaticResource Brush.Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding SelectedDialogue.Order, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>
                                        <TextBox Text="{Binding SelectedDialogue.ScreenText, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="54" ToolTip="On-screen line"/>
                                        <TextBox Text="{Binding SelectedDialogue.Sample, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" ToolTip="VO sample basename (optional)"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding DialogueChoices}" SelectedItem="{Binding SelectedDialogue.Choice}" Margin="0,0,3,0" ToolTip="choice"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding QuestKeys}" Text="{Binding SelectedDialogue.ActivateQuest, UpdateSourceTrigger=LostFocus}" ToolTip="activate_quest (QuestCatalog key)"/>
                                        </Grid>
                                        <WrapPanel>
                                            <CheckBox Content="quest_dialog" IsChecked="{Binding SelectedDialogue.QuestDialog}" Margin="0,0,8,0"/>
                                            <CheckBox Content="nis" IsChecked="{Binding SelectedDialogue.Nis}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Content="Delete conversation" Command="{Binding DeleteConversationCommand}" Margin="0,4,0,0" Padding="8,4"/>
                                </StackPanel>

                                <!-- Map quest -->
                                <StackPanel Visibility="{Binding HasSelectedQuest, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Quest" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes quests/quests.gas (map-wide)" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding QuestKey, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Quest key — what dialogue lines reference via activate_quest (lowercase identifier)"/>
                                    <TextBox Text="{Binding QuestScreenName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Journal display name"/>
                                    <TextBox Text="{Binding QuestDescription, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="70"
                                             ToolTip="Objective text shown in the journal"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Order" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding QuestOrder, UpdateSourceTrigger=LostFocus}" ToolTip="Sort order in the journal"/>
                                    </Grid>
                                    <Button Content="Delete quest" Command="{Binding DeleteQuestCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Nav flag -->
                                <StackPanel Visibility="{Binding HasSelectedFlag, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Nav flag" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes editor/logical_flags.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <WrapPanel Margin="0,0,0,3">
                                        <CheckBox Content="human_player" IsChecked="{Binding FlagHuman}" Margin="0,0,8,0"/>
                                        <CheckBox Content="computer_player" IsChecked="{Binding FlagComputer}" Margin="0,0,8,0"/>
                                        <CheckBox Content="water" IsChecked="{Binding FlagWater}" ToolTip="Impassable to stock actors"/>
                                    </WrapPanel>
                                    <TextBox Text="{Binding FlagSurfaceTag, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3"
                                             ToolTip="Inert surface tag, e.g. lf_dirt / lf_grass (footstep audio)"/>
                                    <Button Content="Delete nav flag" Command="{Binding DeleteNavFlagCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Placed object -->
                                <StackPanel Visibility="{Binding HasSelectedPlacedObject, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Placed object" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes objects/non_interactive.gas · objects/actor.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedPlacedObject.Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedPlacedObject.Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBlock Text="Node-local transform (drag in viewport, or type):" Foreground="{StaticResource Brush.Muted}" FontSize="10" Margin="0,2,0,2"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ObjPosX, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="Y" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding ObjPosY, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="4" Text="Z" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="5" Text="{Binding ObjPosZ, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Yaw°" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ObjYawDeg, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Rotation about the vertical axis, in degrees (Shift-drag in the viewport does the same)"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ObjWorldText}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"
                                               ToolTip="World-space position (local values above are relative to the node this object sits on)"/>
                                    <TextBlock Text="Drag in the viewport to move · Shift-drag to rotate (15° snap in the toolbar) · Ctrl+click others to group." Foreground="{StaticResource Brush.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <!-- ED-4b — per-placement instance overrides -->
                                    <TextBlock Text="Instance overrides" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,0"/>
                                    <TextBlock Text="→ writes [aspect] / [inventory] inside THIS placement's block — the template stays untouched" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Life" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ObjLife, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"
                                                 ToolTip="Hit points for THIS placement only (empty = template's value). Make one krug a 500-life boss while the rest stay stock."/>
                                        <TextBlock Grid.Column="2" Text="Scale ×" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding ObjScale, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Visual size multiplier for THIS placement (empty = 1). DS1 itself uses this — the breakable farmhouse door ships 1.5."/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Drop" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ObjLoot, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Guaranteed item template (e.g. potion_health_small) — dropped on death for actors, found inside for chests/barrels. Adds to the template's own loot roll."/>
                                    </Grid>
                                    <!-- ED-11 — patrol route (actors only) -->
                                    <CheckBox Content="🚶 Draw patrol route (click terrain)" IsChecked="{Binding PatrolMode, Mode=TwoWay}"
                                              IsEnabled="{Binding SelObjIsActor}" Margin="0,2,0,4"
                                              ToolTip="Actors only: tick, then click waypoints on the terrain in order. Unticking closes the loop and assigns it — the actor walks the route in Play. The blue ribbons in the viewport ARE the route; Ctrl+Z removes the whole thing."/>
                                    <Button Content="Delete object" Command="{Binding DeleteObjectCommand}" Padding="8,4"/>
                                </StackPanel>

                                <!-- Node -->
                                <StackPanel Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Node" Style="{StaticResource Header.Section}" Margin="0,0,0,0"/>
                                    <TextBlock Text="→ writes terrain_nodes/nodes.gas" Foreground="{StaticResource Brush.Muted}" FontSize="9" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedNode.Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedNode.Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBlock Text="Texture set" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,4,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableTexsets}" SelectedItem="{Binding SelectedNodeTexset, Mode=TwoWay}"
                                              ToolTip="Re-skin this node with another texture set used in the region — the preview updates live"/>
                                    <TextBlock Text="Doors on this node" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,8,0,3"/>
                                    <ListBox MaxHeight="120" ItemsSource="{Binding SourceDoors}"
                                             SelectedItem="{Binding SelectedSourceDoor, Mode=TwoWay}"
                                             ToolTip="Pick a FREE door here, then Connect (Nodes palette) or Link (below)">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFree}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Free doors on other nodes (link target)" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,8,0,3"/>
                                    <ListBox MaxHeight="100" ItemsSource="{Binding OtherFreeDoors}"
                                             SelectedItem="{Binding SelectedOtherDoor, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Link doors (close loop)" Command="{Binding LinkExistingCommand}" Margin="0,6,0,3" Padding="8,5"
                                            ToolTip="Link this node's free door to a free door on another placed node — closes a loop without adding a node"/>
                                    <Button Content="Delete node" Command="{Binding DeleteNodeCommand}" Margin="0,0,0,3" Padding="8,5"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- ░░ Bottom dock: Region | World | Map ░░ -->
        <Border Grid.Row="3" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <TabControl>
                <TabItem Header="Region" ToolTip="Load/save this region and set its mood + music">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="380"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*" MaxWidth="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Load a region from the game" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding InstallRegions}" SelectedItem="{Binding SelectedInstallRegion, Mode=TwoWay}"
                                      DisplayMemberPath="Display" Margin="0,0,0,3"
                                      ToolTip="Pick a shipped region by name — SiegeSmith already knows where the game is installed"/>
                            <Button Content="…or open a nodes.gas file…" Command="{Binding ImportNodesCommand}" Margin="0,0,0,3" Padding="8,5"
                                    ToolTip="Manually browse to any nodes.gas"/>
                            <Button Content="Save nodes.gas…" Command="{Binding SaveNodesCommand}" Margin="0,6,0,3" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <!-- ED-13 — mod identity manifest (bundled into the .dsmap as siegesmith_mod.txt) -->
                            <TextBlock Text="Mod identity" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"
                                       ToolTip="→ writes siegesmith_mod.txt at the tank root — a distributed .dsmap says what it is and who made it"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MapAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0"
                                         ToolTip="Author name for the mod manifest"/>
                                <TextBox Grid.Column="1" Text="{Binding MapVersion, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Version string (e.g. 1.0)"/>
                            </Grid>
                            <TextBox Text="{Binding MapDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="One-line description for the mod manifest"/>
                            <TextBlock Text="Mood &amp; music" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <Button Content="{Binding MoodInteriorLabel}" Command="{Binding ToggleMoodInteriorCommand}" Margin="0,0,0,3" Padding="8,4"
                                    ToolTip="Interior mood flag (reverb)"/>
                            <TextBox Text="{Binding MoodAmbient, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                     ToolTip="Ambient music track (basename, e.g. m_amb_town) — plays as region audio"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MoodStandard, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0"
                                         ToolTip="Standard music track"/>
                                <TextBox Grid.Column="1" Text="{Binding MoodBattle, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0"
                                         ToolTip="Battle music track"/>
                            </Grid>

                            <!-- ED-8 — atmosphere: fog auditions live in the viewport; rain/snow/wind play in-engine -->
                            <TextBlock Text="Atmosphere" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,8,0,3"
                                       ToolTip="→ writes [fog]/[rain]/[snow]/[wind] into world/global/moods/&lt;map&gt;/moods.gas — the engine's weather system applies all of them"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fog" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MoodFogNear, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0"
                                         ToolTip="Fog start distance in meters from the camera (empty = no fog)"/>
                                <TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="3" Text="{Binding MoodFogFar, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0"
                                         ToolTip="Fog full distance in meters — geometry past this is pure fog colour. Retail moods run ~20–120"/>
                                <TextBlock Grid.Column="4" Text="Col" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="5" Text="{Binding MoodFogColor, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Fog colour, hex — 0xAARRGGBB or #RRGGBB (e.g. #9AA5B1 for a grey morning haze)"/>
                            </Grid>
                            <CheckBox Content="Audition fog in viewport" IsChecked="{Binding MoodFogPreview, Mode=TwoWay}" Margin="0,0,0,3"
                                      ToolTip="Applies the authored fog to the editor preview so you can tune distances and colour without launching the engine"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rain" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MoodRainDensity, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0"
                                         ToolTip="Raindrops per second (retail 30–225; empty = no rain). Plays in the engine via Test/Play"/>
                                <TextBlock Grid.Column="2" Text="Snow" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="3" Text="{Binding MoodSnowDensity, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Snowflakes per second (retail 75–500; empty = no snow)"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wind" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MoodWindVelocity, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0"
                                         ToolTip="Wind velocity in m/s — shears the rain/snow fall direction (empty = calm)"/>
                                <TextBlock Grid.Column="2" Text="Dir°" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Grid.Column="3" Text="{Binding MoodWindDirDeg, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Wind direction in degrees clockwise from north (90 = east)"/>
                            </Grid>
                            <CheckBox Content="Lightning with the rain" IsChecked="{Binding MoodLightning, Mode=TwoWay}"
                                      ToolTip="Storm flashes — retail also forces lightning on whenever rain density drifts ≥ 200"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ED-10 — logic graph views over the real gas models -->
                <TabItem Header="Graph" ToolTip="Visualize trigger wiring, dialogue chains, and quest flow — click any box to select it">
                    <DockPanel Margin="10,8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="View" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="130" ItemsSource="{Binding GraphKinds}" SelectedItem="{Binding SelectedGraphKind, Mode=TwoWay}"
                                      ToolTip="Trigger flow: who fires what (arrows = actions/targets; grey stubs = dangling SCIDs). Dialogue: each conversation's line chain and the quests it activates. Quest flow: chapter → quests → what activates them."/>
                            <Button Content="⟳ Refresh" Command="{Binding RefreshGraphCommand}" Padding="10,3" Margin="8,0,0,0"
                                    ToolTip="Rebuild the graph from the current region (it reads the live trigger/conversation/quest data)"/>
                            <TextBlock Text="Click a box to select and edit it in the Inspector — the graph is a view; the editors stay the source of truth."
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding GraphWidth}" Height="{Binding GraphHeight}">
                                <ItemsControl ItemsSource="{Binding GraphEdges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Stroke="#66FFFFFF" StrokeThickness="1.2"/>
                                                <Ellipse Canvas.Left="{Binding X2}" Canvas.Top="{Binding Y2}" Width="5" Height="5"
                                                         Margin="-2.5,-2.5,0,0" Fill="#88FFFFFF"/>
                                                <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                           Text="{Binding Label}" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding GraphNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding W}" MinHeight="{Binding H}" CornerRadius="4" Padding="7,4"
                                                    Background="#1D1D20" BorderBrush="{Binding Stroke}" BorderThickness="1.4"
                                                    Cursor="Hand" MouseLeftButtonDown="OnGraphNodeClick">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="World" ToolTip="Stitch multiple regions into one continuous world">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" CornerRadius="3" Padding="6,4" Margin="0,0,0,4">
                                <TextBlock Text="{Binding StitchDiagnostics}" Foreground="{StaticResource Brush.Foreground}"
                                           FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{StaticResource Brush.Surface}" CornerRadius="3" ClipToBounds="True">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding WorldGraphEdges}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" StrokeThickness="2">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="{StaticResource Brush.Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Dangling}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource Brush.Accent}"/>
                                                                <Setter Property="StrokeDashArray" Value="3 2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding WorldGraphNodes}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Width="104" Height="36" CornerRadius="3" BorderThickness="1" Padding="4,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Primary}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Reachable}" Value="False">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Foreground}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontSize="9"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <Button DockPanel.Dock="Top" Content="Import sibling region (nodes.gas)…" Command="{Binding ImportSiblingCommand}" Margin="0,0,0,3" Padding="8,5"
                                    ToolTip="Add a neighbouring region to the world so it can be stitched to this one"/>
                            <Button DockPanel.Dock="Bottom" Content="Remove sibling region" Command="{Binding RemoveSiblingCommand}" Margin="0,3,0,0" Padding="8,4"/>
                            <ListBox ItemsSource="{Binding Siblings}" SelectedItem="{Binding SelectedSibling, Mode=TwoWay}">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <DockPanel Grid.Column="4">
                            <TextBlock DockPanel.Dock="Top" Text="Pick a free door on each side, then stitch:" Foreground="{StaticResource Brush.Muted}" FontSize="10" Margin="0,0,0,2"/>
                            <Button DockPanel.Dock="Bottom" Content="Delete selected stitch" Command="{Binding DeleteStitchCommand}" Margin="0,3,0,0" Padding="8,4"/>
                            <ListBox DockPanel.Dock="Bottom" MaxHeight="52" ItemsSource="{Binding PrimaryStitches}" SelectedItem="{Binding SelectedStitch, Mode=TwoWay}" Margin="0,3,0,0">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Button DockPanel.Dock="Bottom" Content="Create reciprocal stitch" Command="{Binding CreateStitchCommand}" Margin="0,3,0,0" Padding="8,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" Margin="0,0,3,0">
                                    <TextBlock DockPanel.Dock="Top" Text="this region" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                    <ListBox ItemsSource="{Binding PrimaryFreeDoors}" SelectedItem="{Binding SelectedPrimaryDoor, Mode=TwoWay}">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontFamily="Consolas" FontSize="10"/>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="sibling region" Foreground="{StaticResource Brush.Muted}" FontSize="10"/>
                                    <ListBox ItemsSource="{Binding SiblingFreeDoors}" SelectedItem="{Binding SelectedSiblingDoor, Mode=TwoWay}">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontFamily="Consolas" FontSize="10"/>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Map" ToolTip="Name, validate, and play the startable map — and author its quests">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="340"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*" MaxWidth="340"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Quests (this map's journal)" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Add quest" Command="{Binding AddQuestCommand}" Margin="0,0,3,0" Padding="6,4"
                                        ToolTip="A journal entry for your game — select it (here or in the Outliner) to edit key, name, and text in the Inspector. Dialogue lines activate it via activate_quest."/>
                                <Button Grid.Column="1" Content="Delete quest" Command="{Binding DeleteQuestCommand}" Padding="6,4"/>
                            </Grid>
                            <TextBox DockPanel.Dock="Bottom" Text="{Binding ChapterIntro, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                                     ToolTip="Chapter intro text (the journal's story panel)" MaxHeight="44" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBox DockPanel.Dock="Bottom" Text="{Binding ChapterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                                     ToolTip="Chapter title shown in the journal"/>
                            <ListBox ItemsSource="{Binding MapQuests}" SelectedItem="{Binding SelectedQuest, Mode=TwoWay}">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.Foreground}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Startable map (SiegeFX engine)" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,3,0" ToolTip="Map name — a map_ prefix is added automatically"/>
                                <TextBox Grid.Column="1" Text="{Binding RegionName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="3,0,0,0" ToolTip="Region name"/>
                            </Grid>
                            <TextBlock Text="Validate / Test terrain / Play live in the toolbar (top right)."
                                       Foreground="{StaticResource Brush.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Nav flags" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <Button Content="Add nav flag for selected node" Command="{Binding AddNavFlagCommand}" Padding="8,5"
                                    ToolTip="logical_flags.gas — toggles passability of an already-walkable node grouping (walkable geometry is baked in the SNO art). Edit it in the Inspector."/>
                        </StackPanel>
                        <DockPanel Grid.Column="4">
                            <TextBlock DockPanel.Dock="Top" Text="Validation checklist" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,0,0,3"/>
                            <!-- ED-16 — world diff + dependency report share this list -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button Content="📸 Baseline" Command="{Binding TakeBaselineCommand}" Padding="6,2" Margin="0,0,4,2" FontSize="11"
                                        ToolTip="Snapshot the region as-is — 'Diff' then lists everything that changed since"/>
                                <Button Content="Diff" Command="{Binding CompareBaselineCommand}" Padding="6,2" Margin="0,0,4,2" FontSize="11"
                                        ToolTip="Compare the region to the baseline snapshot: added / removed / moved per family"/>
                                <Button Content="Dependencies" Command="{Binding DependenciesCommand}" Padding="6,2" Margin="0,0,0,2" FontSize="11"
                                        ToolTip="List everything this region reaches for — templates, textures, audio tracks — with resolution status"/>
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ValidationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Consolas" FontWeight="Bold" Width="16">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#FF28C840"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{StaticResource Brush.Foreground}" MaxWidth="560"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <StatusBar Grid.Row="4">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
