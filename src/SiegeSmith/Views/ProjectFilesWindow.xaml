<Window x:Class="SiegeSmith.ProjectFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pf="clr-namespace:SiegeSmith.ViewModels.ProjectFiles"
        Title="Project Files — SiegeSmith"
        Width="780" Height="660" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="New Folder" Command="{Binding NewFolderCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <Button Content="Open" Command="{Binding OpenCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <Button Content="Reveal" Command="{Binding RevealCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="10,3"/>
                <TextBlock Text="drag to move · drop files to import · drag out to extract"
                           Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
        </StatusBar>

        <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" AllowDrop="True"
                  SelectedItemChanged="OnSelectedChanged"
                  PreviewMouseLeftButtonDown="OnTreeLeftDown" MouseMove="OnTreeMove"
                  DragOver="OnTreeDragOver" Drop="OnTreeDrop"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type pf:ProjectNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="90"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="OnEditVisible" KeyDown="OnEditKey" LostFocus="OnEditLostFocus"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
