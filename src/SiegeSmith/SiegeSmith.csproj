<Project Sdk="Microsoft.NET.Sdk">

  <!-- SiegeSmith — the Dungeon Siege modding studio, built on SiegeFX.Core.
       On .NET 11 (preview 5). The SiegeFX engine projects (Core/Runtime/Tools/
       Audio) are still net8 and referenced cross-target; migrating the engine to
       net11 as well is tracked as the ".NET 11 migration" task. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SiegeSmith</RootNamespace>
    <AssemblyName>SiegeSmith</AssemblyName>
    <Product>SiegeSmith</Product>
    <!-- Early alpha: feature-complete per plan but not yet field-tested by
         the public. Without this property the assembly defaulted to 1.0.0,
         which the About dialog dutifully over-promised. -->
    <Version>0.0.3</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiegeFX.Core\SiegeFX.Core.csproj" />
    <!-- GAME-5 — WavLoader validates imported audio with the engine's own parser. -->
    <ProjectReference Include="..\SiegeFX.Audio\SiegeFX.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\banner.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- ALPHA PACKAGING — activated by publish-alpha.bat (or any publish with
       PublishSingleFile=true): one self-contained SiegeSmith.exe, WPF natives
       riding inside. Normal dev builds are untouched. -->
  <PropertyGroup Condition=" '$(PublishSingleFile)' == 'true' ">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- .NET 11 preview SDK bug: a self-contained publish omits ijwhost.dll, the
       mixed-mode "IJW" host shim that WPF's DirectWriteForwarder.dll imports.
       Without it a self-contained SiegeSmith crashes at startup with a
       DirectWriteForwarder FileNotFoundException ("module could not be
       found"). The framework-dependent dev build works because ijwhost.dll
       lives in the shared WindowsDesktop runtime. Add it to the publish set
       (so it also rides inside the single-file bundle and extracts alongside
       DirectWriteForwarder) straight from the host pack. -->
  <Target Name="IncludeIjwHostForSelfContained"
          BeforeTargets="ComputeResolvedFilesToPublishList;_ComputeFilesToBundle"
          Condition=" '$(RuntimeIdentifier)' != '' and '$(SelfContained)' == 'true' ">
    <PropertyGroup>
      <_IjwHostPath>$(NetCoreRoot)packs\Microsoft.NETCore.App.Host.$(RuntimeIdentifier)\$(BundledNETCoreAppPackageVersion)\runtimes\$(RuntimeIdentifier)\native\ijwhost.dll</_IjwHostPath>
    </PropertyGroup>
    <Error Condition=" !Exists('$(_IjwHostPath)') "
           Text="ijwhost.dll not found at $(_IjwHostPath) — a self-contained WPF publish will crash. Check the host pack version." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_IjwHostPath)">
        <RelativePath>ijwhost.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
